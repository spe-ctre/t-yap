{
  "name": "t-yap-backend",
  "version": "1.0.0",
  "description": "T-Yap Digital Transport Payment Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/swagger && cp -r src/swagger/*.yaml dist/swagger/",
    "start": "node dist/server.js",
    "start:cluster": "CLUSTER_MODE=true node dist/cluster.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "migrate": "dotenv -o -e .env -e .env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -o -e .env -e .env.local -- prisma migrate deploy",
    "generate": "dotenv -o -e .env -e .env.local -- prisma generate",
    "db:pull": "dotenv -o -e .env -e .env.local -- prisma db pull",
    "db:push": "dotenv -o -e .env -e .env.local -- prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.8",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.17.2",
    "prisma": "5.22.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.2",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typescript": "5.4.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^9.0.0",
    "ts-node-dev": "^2.0.0"
  }
}
